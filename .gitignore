# dependencies & build output
node_modules
bin/
*.js
!eslint.config.js

# duplicate copy written by the skills installer (canonical copy is .agents/)
agent/

# OS / editor noise
.DS_Store
**/.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# secrets — never commit
.env
.env.*
*.pem
*.key
secrets*

# Decentraland SDK skills: reinstall with `npx skills add decentraland/sdk-skills --all`
# (pinned in skills-lock.json; third-party docs, not vendored into this repo)
.agents/
.claude/skills/

# Watcher models (Aholo-generated): kept out of the public repo until the creator confirms
# Aholo's terms allow public redistribution. See docs/ASSETS.md.
assets/boss/*.glb
